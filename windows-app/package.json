{
  "name": "mianboor",
  "productName": "Mianboor",
  "version": "1.1.0",
  "description": "Mianboor VPN for Windows — same UI & real-tunnel ping as the Android app",
  "main": "src/main.js",
  "author": "mianboor",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node test/run-tests.js",
    "icon": "node test/make-ico.js",
    "build:win": "electron-packager . Mianboor --platform=win32 --arch=x64 --out=build --overwrite --icon=assets/icon.ico --prune=true --ignore=\"^/build\" --ignore=\"^/test\" --ignore=\"^/xray/xray$\""
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^33.2.0",
    "@electron/packager": "^18.3.6",
    "png-to-ico": "^2.1.8"
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}

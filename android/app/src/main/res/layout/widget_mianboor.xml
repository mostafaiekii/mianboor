<?xml version="1.0" encoding="utf-8"?>
<!-- ویجت خانهٔ میانبر: نقطهٔ وضعیت + متن + دکمهٔ وصل/قطع -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="14dp"
    android:paddingEnd="10dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:background="@drawable/widget_bg">

    <ImageView
        android:id="@+id/widget_dot_on"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:src="@drawable/widget_dot_on"
        android:contentDescription="@string/widget_connected" />

    <ImageView
        android:id="@+id/widget_dot_off"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:src="@drawable/widget_dot_off"
        android:contentDescription="@string/widget_disconnected"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:text="@string/widget_disconnected"
        android:textColor="#FFEEF2F9"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_btn"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:text="@string/widget_connect"
        android:textColor="#FF001C1F"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>

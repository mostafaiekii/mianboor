generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// کانفیگ‌های وی‌پی‌ان — فقط مدیر آن‌ها را وارد می‌کند و کاربران هرگز لینک خام را نمی‌بینند
model VpnConfig {
  id        String   @id @default(cuid())
  name      String
  link      String
  country   String   @default("نامشخص")
  active    Boolean  @default(true)
  premium   Boolean  @default(false)
  createdAt DateTime @default(now())
}

// دستگاه‌های نصب‌شده — با هر sync ثبت/به‌روز می‌شوند؛ پرمیوم بودن اینجا تعیین می‌شود
model Device {
  id             String    @id // MB-XXXX-XXXX (ANDROID_ID hash از اپ)
  premiumUntil   DateTime?
  label          String    @default("") // مدل گوشی (اختیاری، از اپ می‌آید)
  appVersion     String    @default("")
  refCode        String    @default("") // کد معرف این دستگاه (دعوت دوستان)
  referredBy     String    @default("") // کد معرفی که این دستگاه با آن ثبت شده
  refGiftPending Int       @default(0)  // روزهای هدیهٔ دریافت‌نشده (رفرال)
  refCount       Int       @default(0)  // تعداد دوستانی که با این کد ثبت شده‌اند
  lastSeenAt     DateTime  @default(now())
  createdAt      DateTime  @default(now())

  @@index([refCode])
}

// سفارش‌های خرید — روی سرور ثبت می‌شوند تا پس از بررسی تأیید شوند
model Order {
  id        String   @id // MB-1234
  deviceId  String
  plan      String // p1 | p3 | p6
  price     Int
  via       String // gateway | telegram
  status    String   @default("pending") // pending | approved | rejected
  createdAt DateTime @default(now())
}

// تنظیمات عمومی (شماره کارت پرداخت و ...) — از سمت مدیریت قابل ویرایش
model AppSetting {
  key   String @id
  value String
}

// اعلان‌های مدیریت — صندوق کاربر یا پاپ‌آپ داخل اپ (از پنل مدیریت ارسال می‌شود)
model Notice {
  id        String   @id @default(cuid())
  title     String
  body      String
  kind      String   @default("inbox") // inbox | popup  (legacy — از channels مشتق می‌شود)
  ntype     String   @default("info")  // info | gift | warn | update
  audience  String   @default("all")   // all | free | premium
  channels  String   @default("[\"inbox\"]") // JSON: ["inbox","popup","push"]
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// وضعیت خواندن هر اعلان به تفکیک دستگاه
model NoticeRead {
  noticeId String
  deviceId String
  readAt   DateTime @default(now())

  @@id([noticeId, deviceId])
}
